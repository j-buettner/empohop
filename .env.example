# Copy this file to .env and fill in your values.
# .env is already in .gitignore — never commit real secrets.

# ---------------------------------------------------------------------------
# Backend selection
# ---------------------------------------------------------------------------

# Which LLM backend to use: "anthropic" (default) or "external"
# LLM_BACKEND=anthropic

# ---------------------------------------------------------------------------
# Anthropic backend  (LLM_BACKEND=anthropic)
# ---------------------------------------------------------------------------

# Required when using the Anthropic backend.
# Obtain from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# External OpenAI-compatible backend  (LLM_BACKEND=external)
# ---------------------------------------------------------------------------

# Required when using the external backend.
EXTERNAL_API_TOKEN=your-token-here

# Available models for the external backend:
#   openai-gpt-oss-120b  |  qwen3-235b-a22b  |  glm-4.7
# Default when LLM_BACKEND=external: qwen3-235b-a22b
# KG_MODEL=qwen3-235b-a22b

# ---------------------------------------------------------------------------
# Optional — LLM settings (apply to both backends)
# ---------------------------------------------------------------------------

# Override the model (see backend-specific defaults above)
# KG_MODEL=claude-sonnet-4-20250514

# Maximum tokens per LLM response.
# Default: 8000
# KG_MAX_TOKENS=8000

# ---------------------------------------------------------------------------
# Optional — file paths
# ---------------------------------------------------------------------------

# Knowledge graph file served by server.py (visualisation server).
# Default: data/processed/politics_of_ron_core_chunks_clean_knowledge_graph.json
# KG_FILE=data/processed/my_knowledge_graph.json

# Knowledge graph file used by human_review.py to load entity detail.
# Default: data/processed/book_9780262366601-compressed_knowledge_graph.json
# KG_FILE_REVIEW=data/processed/my_knowledge_graph.json

# ---------------------------------------------------------------------------
# Optional — logging
# ---------------------------------------------------------------------------

# Log level: DEBUG | INFO | WARNING | ERROR   (default: INFO)
# LOG_LEVEL=INFO

# Log format: "json" for structured JSON output, anything else for plain text.
# Set to "json" when running in a log aggregator (e.g. CloudWatch, Datadog).
# LOG_FORMAT=text
